---
import Icon from './Icon.astro';
import { displayName, nav, site, socials } from '../data/site';
import { attrsFor, attrsForSocial } from '../lib/links';

const year = new Date().getFullYear();
const footLinks = nav.filter((item) => item.label !== '首页');
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true">{displayName.slice(0, 1).toUpperCase()}</span>
          <span class="brand__text">{displayName}</span>
        </a>
        <p>{site.tagline}</p>
        <p class="mono" style="font-size: 0.72rem; letter-spacing: 0.04em;">
          Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
          · 部署在 Vercel
        </p>
      </div>

      <div>
        <p class="eyebrow" style="margin-bottom: 0.85rem;">导航</p>
        <ul class="footer__links">
          {
            footLinks.map((item) => (
              <li>
                <a href={item.href} {...attrsFor(item.external)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="eyebrow" style="margin-bottom: 0.85rem;">在别处</p>
        <ul class="footer__links">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  {...attrsForSocial(s.external)}
                  style="display: inline-flex; align-items: center; gap: 0.35rem;"
                >
                  <Icon name={s.icon} size={13} />
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {site.startYear}–{year} {site.name}. All rights reserved.</span>
      <span>
        {
          site.icp && (
            <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">
              {site.icp}
            </a>
          )
        }
        <span>Made with 折腾.</span>
      </span>
    </div>
  </div>
</footer>
