---
/**
 * 统一图标组件：
 * - 品牌图标来自 simple-icons（24×24，纯色填充）
 * - 通用图标是手写的描边图标，风格保持一致
 */
import { siBilibili, siGitee, siGit, siGithub, siHexo, siLinux } from 'simple-icons';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = '' } = Astro.props;

const brands: Record<string, { path: string }> = {
  github: siGithub,
  bilibili: siBilibili,
  gitee: siGitee,
  git: siGit,
  hexo: siHexo,
  linux: siLinux,
};

const stroke: Record<string, string> = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  activity: '<path d="M3 12h3.5l2.5-7 4 14 2.5-7H21"/>',
  code: '<path d="m8.5 8-4.5 4 4.5 4"/><path d="m15.5 8 4.5 4-4.5 4"/>',
  terminal: '<path d="m5 8 4 4-4 4"/><path d="M12.5 16H19"/>',
  cloud: '<path d="M7.5 18.5a4.5 4.5 0 0 1-.4-8.98A5.8 5.8 0 0 1 18 9.7a4.4 4.4 0 0 1-.6 8.8z"/>',
  cpu: '<rect x="6.5" y="6.5" width="11" height="11" rx="2"/><rect x="10" y="10" width="4" height="4" rx="1"/><path d="M9.5 3v3.5M14.5 3v3.5M9.5 17.5V21M14.5 17.5V21M3 9.5h3.5M3 14.5h3.5M17.5 9.5H21M17.5 14.5H21"/>',
  book: '<path d="M4.5 19V5.5A2 2 0 0 1 6.5 3.5H19v17H6.5a2 2 0 0 1-2-1.5z"/><path d="M8.5 8h7"/>',
  arrow: '<path d="M6.5 17.5 17.5 6.5"/><path d="M9.5 6.5h8v8"/>',
  external: '<path d="M14 4h6v6"/><path d="M20 4 10.5 13.5"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  link: '<path d="m9.5 14.5 5-5"/><path d="M7.5 12 5 14.5a3.54 3.54 0 0 0 5 5L12.5 17"/><path d="m11.5 7 2.5-2.5a3.54 3.54 0 0 1 5 5L16.5 12"/>',
  rss: '<path d="M5 19h.01"/><path d="M5 12.5a6.5 6.5 0 0 1 6.5 6.5"/><path d="M5 5.5A13.5 13.5 0 0 1 18.5 19"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"/>',
  moon: '<path d="M20.5 14.8A8.6 8.6 0 0 1 9.2 3.5a8.6 8.6 0 1 0 11.3 11.3z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  spark: '<path d="m12 3 1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/>',
  layers: '<path d="m12 3 8.5 4.5L12 12 3.5 7.5z"/><path d="m3.5 12.5 8.5 4.5 8.5-4.5"/>',
  bolt: '<path d="M13.5 3 5.5 13.5H11l-1 7.5 8.5-11H13z"/>',
};

const brand = brands[name];
const body = stroke[name] ?? stroke.link;
---
{
  brand ? (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d={brand.path} />
    </svg>
  ) : (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      set:html={body}
    />
  )
}
