---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {
  awards,
  blogTopics,
  certificates,
  education,
  quickFacts,
  realName,
  site,
  socials,
  techStack,
  timeline,
} from '../data/site';
import { attrsForSocial, externalAttrs } from '../lib/links';
---

<Base
  title="关于"
  description={`关于 ${realName}（${site.name}）：计算机科学与技术专业在读，嵌入式与 FPGA 方向，记录 C/C++、单片机、硬件调试与 Linux 实践。`}
>
  <header class="page-head container">
    <span class="eyebrow">About</span>
    <h1>关于<span class="grad-text">我</span></h1>
    <p>{site.role}</p>
  </header>

  <section class="container">
    <div class="prose reveal">
      <p>
        我是 <strong>{realName}</strong>{realName && `（@${site.name}）`}，现在在
        <strong>湖北文理学院理工学院</strong>读计算机科学与技术（专升本），
        之前在<strong>湖北三峡职业技术大学</strong>学电子信息工程技术。
        我对硬件的底层世界一直很好奇，相信<strong>代码能赋予硬件灵魂</strong>，
        也享受从比特流到物理交互的整个过程。
      </p>
      <p>
        现在主要深耕 <strong>C/C++、STM32/ESP32、Verilog 和 FPGA</strong>，
        一边打通软硬件之间的链路，一边往数据结构与算法、操作系统原理这些更上层的东西补。
        「{site.motto}」是我贴在桌前的一句话。
      </p>
      <p>
        我习惯把过程写下来。<a href={site.blogUrl} {...externalAttrs}>博客</a>
        既写外设驱动、RTOS 这类技术解析，也记完整的项目开发日志，
        还有环境配置与排错——WSL 迁移、麒麟系统装 JDK、VS Code 配 MinGW 这些「下次还会用」的存档。
      </p>
      <p>
        离开编辑器的时候，多半在骑车穿城、拿手机拍点东西。
        这个主页就是把上面这些东西收拢在一起的入口。
      </p>
    </div>

    <div class="section-head reveal" style="margin-top: 3.5rem;">
      <div class="section-head__text">
        <span class="eyebrow">01 / Now</span>
        <h2>现在</h2>
        <p>在哪儿读书、每天在跟什么打交道。</p>
      </div>
    </div>

    <div class="edu-grid">
      {
        education.map((item, i) => (
          <div class="edu reveal" style={`--d:${i * 70}ms`}>
            <span class:list={['edu__status', { 'edu__status--now': item.status === '在读' }]}>
              {item.status}
            </span>
            <p class="edu__school">{item.school}</p>
            <p class="edu__major">{item.major}</p>
            <p class="edu__note">{item.note}</p>
          </div>
        ))
      }
    </div>

    <div
      class="about-grid"
      style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));"
    >
      {
        quickFacts.map((fact, i) => (
          <div class="fact reveal" style={`--d:${i * 60}ms`}>
            <span class="fact__icon">
              <Icon name={fact.icon} size={17} />
            </span>
            <span>
              <span class="fact__label">{fact.label}</span>
              <span class="fact__value" style="display: block;">{fact.value}</span>
            </span>
          </div>
        ))
      }
    </div>

    <div class="section-head reveal" style="margin-top: 3.5rem;">
      <div class="section-head__text">
        <span class="eyebrow">02 / Toolbox</span>
        <h2>手边的东西</h2>
        <p>从示波器到编辑器，能拿来把想法变成能跑的东西。</p>
      </div>
    </div>

    <div
      class="about-grid"
      style="margin-top: 0; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));"
    >
      {
        techStack.map((group, i) => (
          <div class="fact reveal" style={`--d:${i * 70}ms; display: block;`}>
            <p class="fact__label">{group.title}</p>
            <ul class="card__tags" style="margin-top: 0.6rem;">
              {group.items.map((item) => <li class="tag">{item}</li>)}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="section-head reveal" style="margin-top: 3.5rem;">
      <div class="section-head__text">
        <span class="eyebrow">03 / Honors</span>
        <h2>荣誉与证书</h2>
        <p>比赛和奖学金，按时间倒序。</p>
      </div>
    </div>

    <div class="awards" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 430px), 1fr));">
      {
        awards.map((award, i) => (
          <div class="award reveal" style={`--d:${Math.min(i, 6) * 45}ms`}>
            <span class="award__year">{award.year}</span>
            {award.href ? (
              <a class="award__title award__title--link" href={award.href} {...externalAttrs}>
                {award.title}
                <Icon name="arrow" size={12} />
              </a>
            ) : (
              <span class="award__title">{award.title}</span>
            )}
          </div>
        ))
      }
    </div>

    <ul class="chips reveal" aria-label="证书">
      {certificates.map((cert) => <li class="chip">{cert}</li>)}
    </ul>

    <div class="section-head reveal" style="margin-top: 3.5rem;">
      <div class="section-head__text">
        <span class="eyebrow">04 / Timeline</span>
        <h2>时间线</h2>
      </div>
    </div>

    <ol class="timeline">
      {
        timeline.map((item) => (
          <li class="reveal">
            <span class="timeline__year">{item.year}</span>
            <p class="timeline__title">{item.title}</p>
            <p class="timeline__body">{item.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="section-head reveal" style="margin-top: 3.5rem;">
      <div class="section-head__text">
        <span class="eyebrow">05 / Journal</span>
        <h2>博客里写什么</h2>
        <p>四类内容，都在 <a class="prose-link" href={site.blogUrl} {...externalAttrs}>blog.lczhuigz.cn</a>。</p>
      </div>
    </div>

    <div class="topics">
      {
        blogTopics.map((topic, i) => (
          <div class="topic reveal" style={`--d:${i * 60}ms`}>
            <span class="topic__label">{topic.label}</span>
            <span class="topic__note">{topic.note}</span>
          </div>
        ))
      }
    </div>

    <div class="panel reveal" style="margin-top: 3.5rem;">
      <span class="eyebrow">06 / Elsewhere</span>
      <h2 style="margin-top: 0.8rem; font-size: clamp(1.4rem, 3vw, 1.9rem);">在别的地方找到我</h2>
      <ul class="hero__socials" style="margin-top: 1.2rem;">
        {
          socials.map((s) => (
            <li>
              <a class="social-link" href={s.href} {...attrsForSocial(s.external)}>
                <Icon name={s.icon} size={15} />
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
